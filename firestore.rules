rules_version = '2';

// Interlude Phase 1 — no authentication, exactly one shared room.
// Because there's no auth, these rules can't verify *who* is writing —
// only *what* is being written and *where*. They lock every write down
// to the specific known document paths and a whitelist of fields, so a
// stranger with the API key can't use this project to store arbitrary
// data or spam unrelated collections.
service cloud.firestore {
  match /databases/{database}/documents {

    // Slot immutability: once user1Id/user2Id is set, no write may
    // change it to a different value — only a still-empty slot may be
    // filled. This is what actually enforces "reject a 3rd user,
    // never replace anyone" at the data layer, since app logic alone
    // (claimSlot's transaction) can't be trusted from a rules
    // perspective when there's no auth.
    function slotUnchanged(field) {
      return !(field in resource.data)
        || !(field in request.resource.data)
        || resource.data[field] == request.resource.data[field];
    }

    match /rooms/main-room {
      allow read: if true;
      allow create, update: if request.resource.data.keys()
        .hasOnly(['user1Id', 'user2Id', 'createdAt', 'hostId'])
        && slotUnchanged('user1Id')
        && slotUnchanged('user2Id');
      allow delete: if false;
    }

    match /rooms/main-room/presence/{slot} {
      allow read: if true;
      allow create, update: if slot in ['user1', 'user2']
        && request.resource.data.keys()
          .hasOnly(['userId', 'connected', 'lastSeen', 'sessionId', 'engineVersion']);
      allow delete: if false;
    }

    match /rooms/main-room/state/ready {
      allow read: if true;
      allow create, update: if request.resource.data.keys()
        .hasOnly(['user1Ready', 'user2Ready']);
      allow delete: if false;
    }

    match /rooms/main-room/state/sync {
      allow read: if true;
      allow create, update: if request.resource.data.keys()
        .hasOnly(['countdownStartAt', 'countdownId', 'active']);
      allow delete: if false;
    }

    match /rooms/main-room/state/player {
      allow read: if true;
      allow create, update: if request.resource.data.keys()
        .hasOnly(['playbackState', 'lastAction', 'actionBy', 'actionAt', 'actionId']);
      allow delete: if false;
    }

    match /rooms/main-room/meta/clockSync {
      allow read, write: if true;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
